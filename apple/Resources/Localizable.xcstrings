    "Apple Watch 尚未安装鱼饼 Watch App，请先安装后再传输" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "YuBing Watch App is not installed on Apple Watch. Install it before transferring."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Watch に魚餅 Watch App がインストールされていません。インストールしてから転送してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Watch에 YuBing Watch App이 설치되어 있지 않습니다. 설치한 뒤 전송하세요."
          }
        },
        "zh-Hans" : {
