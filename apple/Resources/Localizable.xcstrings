    "错峰延迟让每一行依次跟上，数值越大层次越明显。" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stagger makes each line follow in turn; larger values make the effect more pronounced."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スタガーは各行を順に追従させます。値が大きいほど段差が際立ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "스태거는 각 행이 차례로 따라오게 합니다. 값이 클수록 효과가 뚜렷해집니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "错峰延迟让每一行依次跟上，数值越大层次越明显。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "錯峰延遲讓每一行依次跟上，數值越大層次越明顯。"
          }
        }
      }
    },
